meta {
  name: GET enrollments enrollmentId assignments
  type: http
  seq: 142
}

get {
  url: {{baseUrl}}/enrollments/{{enrollmentId}}/assignments
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  URI: api/enrollments/{enrollmentId}/assignments
  Action: App\Http\Controllers\Api\AssignmentController@index
  Middleware: api, Illuminate\Auth\Middleware\Authenticate:sanctum
  Response Notes: Setiap assignment pada list dapat menyertakan flag is_supplemental, counts_toward_progress, counts_toward_certificate, source, is_locked, is_new, dan is_completed.
}
