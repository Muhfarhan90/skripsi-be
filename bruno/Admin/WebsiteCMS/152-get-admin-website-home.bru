meta {
  name: GET admin website home
  type: http
  seq: 152
}

get {
  url: {{baseUrl}}/admin/website/home
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  URI: api/admin/website/home
