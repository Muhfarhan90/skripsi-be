meta {
  name: GET admin website settings
  type: http
  seq: 150
}

get {
  url: {{baseUrl}}/admin/website-settings
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  URI: api/admin/website-settings
  Action: App\Http\Controllers\Api\Admin\WebsiteSettingController@show
  Middleware: api, Illuminate\Auth\Middleware\Authenticate:sanctum, App\Http\Middleware\EnsureAdminAccess
}
